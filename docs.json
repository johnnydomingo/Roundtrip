{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "aspen",
  "name": "Roundtrip",
  "colors": {
    "primary": "#3B82F6",
    "light": "#93C5FD",
    "dark": "#1D4ED8"
  },
  "favicon": "/favicon.svg",
  "navigation": {
  "global": {
    "anchors": [
      {
        "anchor": "Status",
        "icon": "signal",
        "href": "https://status.roundtrip.dev"
      }
    ]
  },
  "tabs": [
    {
      "tab": "Documentation",
      "groups": [
        {
          "group": "Get started",
          "icon": "rocket",
          "public": true,
          "pages": ["index", "quickstart", "workspaces"]
        },
        {
          "group": "Billing",
          "icon": "receipt",
          "pages": ["billing"]
        }
      ]
    },
    {
      "tab": "Subscribers",
      "icon": "circle-user",
      "menu": [
        {
          "item": "Endpoint testing",
          "icon": "circle-check",
          "pages": ["customers/assertions"]
        },
        {
          "item": "Query console",
          "icon": "database",
          "pages": ["customers/query-console", "customers/limits"]
        }
      ]
    },
    {
      "tab": "Internal",
      "icon": "lock",
      "groups": [
        {
          "group": "Support",
          "pages": ["internal/runbook"]
        }
      ]
    }
  ]
},
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "mailto:test@test.com"
      }
    ]
  },
  "contextual": {
    "options": [
      "copy",
      "view"
    ]
  }
}
